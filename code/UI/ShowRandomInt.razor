@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="title">@MyStringValue</div>
</root>

@code
{
	private string MyStringValue { get; set; } = "";
	private TimeSince _timer = 0f;
	private int _random = 0;

	protected override int BuildHash() => System.HashCode.Combine( Time.Now ); // Time.Now because every frame

	protected override void OnUpdate()
	{
		if (_timer > 5f)
		{
			SetupRandom();

			_timer = 0f;
		}
	}

	[Button("Setup New Random")]
	public void SetupRandom()
	{
		_random = Game.Random.Int(0, 1000);

		MyStringValue = _random.ToString();
	}
}
